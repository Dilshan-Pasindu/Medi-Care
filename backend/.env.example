PORT=3001
NODE_ENV=development

# Supabase PostgreSQL Database (Connection Pooler)
# Note: If your password contains '@', encode it as '%40'
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Cryptographically Secure 256-bit JWT Secret Key
JWT_SECRET=your-secure-jwt-secret-key-here

# Google Gemini AI API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
